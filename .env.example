# Thought Orchard configuration. Copy to .env.local (development) or set these
# in your hosting provider (production). Placeholder values only — never commit
# real secrets. See README "Deployment".

# --- Database (required in production) -------------------------------------
# A MongoDB connection string. Development without this starts a local
# database in .data/mongo automatically.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.example.mongodb.net/?retryWrites=true&w=majority
# Database name (default: thought_orchard)
MONGODB_DB=thought_orchard
# "true" only if your MongoDB is a replica set (MongoDB Atlas is). Enables
# transactions in the auth adapter. Leave unset for a standalone server.
MONGODB_TRANSACTIONS=false

# --- Authentication (required in production) --------------------------------
# A random secret of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# The public URL of the app, e.g. https://orchard.example.com
BETTER_AUTH_URL=http://localhost:3000
# Extra allowed origins, comma-separated (optional)
TRUSTED_ORIGINS=
# Rate limiting on sign-in, sign-up and password reset: "on" (default) or "off"
AUTH_RATE_LIMIT=on

# --- Email (optional; needed for password reset in production) -------------
# Resend (https://resend.com) API key and a verified sender address.
RESEND_API_KEY=
EMAIL_FROM="Thought Orchard <no-reply@orchard.example.com>"
# "true" requires new accounts to confirm their email before signing in.
# Needs RESEND_API_KEY and EMAIL_FROM.
REQUIRE_EMAIL_VERIFICATION=false

# --- Client (optional) -------------------------------------------------------
# Only for a separately hosted client such as the future mobile app.
NEXT_PUBLIC_API_BASE_URL=
